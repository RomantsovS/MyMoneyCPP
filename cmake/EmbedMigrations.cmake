# Embeds SQL migration scripts into the binary (ADR-0013).
#
# C++23 has no #embed yet, so at configure time each .sql file is read and
# written into a generated .cpp file as a raw string literal. CMake re-runs this
# step automatically when a .sql file changes (CMAKE_CONFIGURE_DEPENDS).
#
#   mymoney_embed_migrations(OUTPUT <generated .cpp> SCRIPTS 0001_x.sql ...)
#
# Scripts must be named NNNN_description.sql with versions 1, 2, 3, ... in order.

function(mymoney_embed_migrations)
  cmake_parse_arguments(PARSE_ARGV 0 arg "" "OUTPUT" "SCRIPTS")

  # MSVC limits a single string literal to about 16 KB; split bigger scripts.
  set(max_script_size 16000)

  set(entries "")
  set(expected_version 1)
  foreach(script IN LISTS arg_SCRIPTS)
    cmake_path(ABSOLUTE_PATH script NORMALIZE OUTPUT_VARIABLE script_path)
    cmake_path(GET script_path FILENAME script_name)

    if(NOT script_name MATCHES "^([0-9][0-9][0-9][0-9])_[a-z0-9_]+\\.sql$")
      message(FATAL_ERROR "Migration '${script_name}': expected NNNN_name.sql")
    endif()
    math(EXPR version "${CMAKE_MATCH_1}")  # "0001" -> 1
    if(NOT version EQUAL expected_version)
      message(FATAL_ERROR
        "Migration '${script_name}': expected version ${expected_version}")
    endif()
    math(EXPR expected_version "${expected_version} + 1")

    file(READ "${script_path}" sql)
    string(LENGTH "${sql}" sql_size)
    if(sql_size GREATER max_script_size)
      message(FATAL_ERROR "Migration '${script_name}' is too long; split it")
    endif()
    string(FIND "${sql}" ")mymoney_sql\"" delimiter_found)
    if(NOT delimiter_found EQUAL -1)
      message(FATAL_ERROR "Migration '${script_name}' contains the delimiter")
    endif()

    string(APPEND entries
      "    MigrationScript{.version = ${version},\n"
      "                    .name = \"${script_name}\",\n"
      "                    .sql = R\"mymoney_sql(${sql})mymoney_sql\"},\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${script_path}")
  endforeach()

  list(LENGTH arg_SCRIPTS count)
  set(content
"// Generated by cmake/EmbedMigrations.cmake from storage/migrations/*.sql.
// Do not edit: change the .sql files instead.

#include <array>
#include <span>

#include \"storage/migrations.h\"

namespace mymoney::storage {
namespace {

constexpr std::array<MigrationScript, ${count}> kMigrationScripts{
${entries}};

}  // namespace

std::span<const MigrationScript> EmbeddedMigrationScripts() {
  return kMigrationScripts;
}

}  // namespace mymoney::storage
")
  # Writes only when the content changed, so unchanged scripts cause no rebuild.
  file(CONFIGURE OUTPUT "${arg_OUTPUT}" CONTENT "${content}" @ONLY)
endfunction()
