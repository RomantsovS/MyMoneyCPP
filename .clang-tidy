# Static analysis and Google naming rules (ADR-0008, ADR-0011).
# Subdirectories may add a .clang-tidy with "InheritParentConfig: true" to adjust it.
---
Checks:
  - '-*'
  - 'bugprone-*'
  # Flags every function with two adjacent parameters of the same type, e.g.
  # (int64_t from, int64_t to). Very noisy; we prevent mix-ups with strong types
  # (AccountId, Money) instead.
  - '-bugprone-easily-swappable-parameters'
  - 'clang-analyzer-*'
  - 'cppcoreguidelines-*'
  # Alias of readability-magic-numbers (see there).
  - '-cppcoreguidelines-avoid-magic-numbers'
  # Alias of misc-non-private-member-variables-in-classes (see there).
  - '-cppcoreguidelines-non-private-member-variables-in-classes'
  - 'google-*'
  # Requires TODO(username) comments - pointless with a single developer.
  - '-google-readability-todo'
  - 'misc-*'
  # Reports "unused" and "missing direct" includes; produces many false
  # positives with Qt's umbrella headers and GoogleTest macros.
  - '-misc-include-cleaner'
  # Flags public data members in classes. Google style allows them in plain
  # structs, and protected members are reported as well.
  - '-misc-non-private-member-variables-in-classes'
  - 'modernize-*'
  # Wants "auto f() -> int" for every function - contradicts Google style.
  - '-modernize-use-trailing-return-type'
  - 'performance-*'
  - 'portability-*'
  - 'readability-*'
  # Rejects short but clear names like i, id, db.
  - '-readability-identifier-length'
  # Reports every literal (100, 10000, 2) as a "magic number" - too noisy in
  # money calculations and tests; named constants are required by review instead.
  - '-readability-magic-numbers'

# Like compiler warnings (ADR-0011): every finding must be fixed or explicitly
# suppressed with NOLINT(<check>) and a reason.
WarningsAsErrors: '*'

# Only report problems in our own headers, not in Qt, GoogleTest or the standard library.
HeaderFilterRegex: '.*[/\\]src[/\\].*'
FormatStyle: file

# clang-tidy parses MSVC compile commands with clang, which does not know every
# MSVC flag (e.g. /Zc:preprocessor). Unknown flags are not code problems.
ExtraArgs:
  - '-Wno-unused-command-line-argument'

CheckOptions:
  # Interfaces (e.g. AccountRepository) declare only "virtual ~X() = default;".
  # Requiring all five special members there adds noise without any benefit.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  # static_cast<void>(...) is our explicit way to say a result is ignored on
  # purpose (e.g. ROLLBACK in a destructor, where an error cannot be handled).
  bugprone-unused-return-value.AllowCastToVoid: true
  # We do not throw (ADR-0008). Exceptions the standard library may throw on
  # allocation failure or I/O, locale and formatting errors are fatal by design -
  # the same behaviour as with exceptions disabled - so they are not reported.
  # Format: unqualified type names, separated by commas.
  bugprone-exception-escape.IgnoredExceptions: 'bad_alloc,bad_array_new_length,length_error,format_error,system_error,bad_cast'

  # --- Google naming ---
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  # Google allows accessors/mutators named like variables: amount(), set_amount().
  readability-identifier-naming.MethodIgnoredRegexp: '^(set_)?[a-z][a-z0-9_]*$'
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Google-style header guards end with an underscore: MYMONEY_CORE_VERSION_H_.
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^MYMONEY_[A-Z0-9_]+_H_$'
