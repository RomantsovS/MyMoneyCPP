# Store text files with LF line endings and check them out with LF on every OS.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.jks binary
*.sqlite binary
